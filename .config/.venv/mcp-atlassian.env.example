# MCP Atlassian — credenciais de acesso ao Jira e Confluence
# Copie este arquivo para .config/.venv/mcp-atlassian.env e preencha os valores
# Gere seu token em: https://id.atlassian.com/manage-profile/security/api-tokens

JIRA_URL=https://sua-empresa.atlassian.net
JIRA_USERNAME=seu.email@empresa.com
JIRA_API_TOKEN=seu_token_aqui

CONFLUENCE_URL=https://sua-empresa.atlassian.net/wiki
CONFLUENCE_USERNAME=seu.email@empresa.com
CONFLUENCE_API_TOKEN=seu_token_aqui
