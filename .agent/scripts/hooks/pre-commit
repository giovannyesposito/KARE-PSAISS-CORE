#!/bin/sh
# .agent/scripts/hooks/pre-commit
# Bloqueia commits que contenham credenciais ou segredos em plain-text.
#
# Padrões detectados:
#   • API tokens Atlassian (ATATT3x...)
#   • Senhas com padrão @Letras+Números
#   • Chaves genéricas (API_KEY, SECRET, PASSWORD = "...")
#   • Tokens Bearer / JWT em texto plano
#
# Para instalar: execute .agent/scripts/infra/install_hooks.ps1

RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

STAGED=$(git diff --cached --name-only)

if [ -z "$STAGED" ]; then
  exit 0
fi

BLOCKED=0

# Padrões de credenciais proibidas
PATTERNS='ATATT3x[A-Za-z0-9+/]|password\s*=\s*["'"'"'][^"'"'"']{6,}|api_token\s*=\s*["'"'"'][^"'"'"']{6,}|secret\s*=\s*["'"'"'][^"'"'"']{6,}|Bearer [A-Za-z0-9\-_\.]{20,}|@[A-Z][0-9][a-z0-9]{4,};'

for FILE in $STAGED; do
  # Ignorar arquivos binários e já excluídos
  if [ ! -f "$FILE" ]; then
    continue
  fi

  # Ignorar arquivos .enc (já criptografados)
  case "$FILE" in
    *.enc|*.key|*.db|*.pdf|*.pptx|*.png|*.jpg|*.jpeg|*.gif|*.ico|*.woff*)
      continue
      ;;
  esac

  # Filtra: variáveis shell/PS ($var, ${var}) e comentários não são credenciais reais
  MATCH=$(git diff --cached -- "$FILE" | grep "^+" | grep -iE "$PATTERNS" | grep -v "^+++" | grep -vE "='\\\$[a-zA-Z_]|=\"\\\$[a-zA-Z_]|=\\\$[a-zA-Z_]|\\\$\{[A-Z_]+\}" | head -3)

  if [ -n "$MATCH" ]; then
    echo ""
    echo "${RED}⛔ BLOQUEADO — Credencial detectada em: $FILE${NC}"
    echo "${YELLOW}Trecho suspeito:${NC}"
    echo "$MATCH" | head -3
    echo ""
    BLOCKED=1
  fi
done

if [ "$BLOCKED" -eq 1 ]; then
  echo "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
  echo "${RED}  COMMIT BLOQUEADO — Remova as credenciais antes de commitar.${NC}"
  echo "${RED}  Use python .agent/scripts/kare_credentials.py setup${NC}"
  echo "${RED}  para armazenar credenciais de forma segura (AES-256-GCM).${NC}"
  echo "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
  exit 1
fi

exit 0
