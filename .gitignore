# Credenciais em texto plano — nunca versionar (só os *.env.example são commitados)
.config/.venv/*.env

# NOTA: *.enc (kare_credentials.py) É intencionalmente versionável — é
# criptografado com AES-256-GCM e a chave nunca sai de %USERPROFILE%\kare.key,
# fora do repositório. Sem a chave, o .enc é inútil para quem clonar o repo.

# Python
__pycache__/
*.pyc

# RAG — bases geradas/acumuladas localmente, nunca versionar
